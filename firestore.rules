rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Newsletter subscribers - allow server-side access for admin operations
    match /newsletter_subscribers/{document} {
      // Allow authenticated users to read/write their own subscription
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      
      // Allow server-side admin access (for newsletter sending)
      allow read: if request.auth == null; // Server-side functions don't have auth context
      
      // Allow admin users to read all subscribers
      allow read: if request.auth != null && request.auth.uid in ['ADMIN_UID_HERE'];
    }
    
    // Orders - allow admin and server-side access
    match /orders/{document} {
      // Allow customers to read their own orders
      allow read: if request.auth != null && request.auth.uid == resource.data.customerId;
      
      // Allow server-side access for order processing and email sending
      allow read, write: if request.auth == null; // Server-side functions
      
      // Allow admin users full access
      allow read, write: if request.auth != null && request.auth.uid in ['ADMIN_UID_HERE'];
    }
    
    // Products - public read access, admin write access
    match /products/{document} {
      allow read: if true; // Public read access
      allow write: if request.auth != null && request.auth.uid in ['ADMIN_UID_HERE'];
    }
    
    // Settings - admin only
    match /settings/{document} {
      allow read, write: if request.auth != null && request.auth.uid in ['ADMIN_UID_HERE'];
      allow read: if request.auth == null; // Server-side access for order confirmations
    }
    
    // Newsletter history - admin only
    match /newsletter_emails/{document} {
      allow read, write: if request.auth != null && request.auth.uid in ['ADMIN_UID_HERE'];
      allow write: if request.auth == null; // Server-side access for logging sent emails
    }
  }
}