rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to products for everyone, inventory updates for webhooks
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if request.auth != null &&
        request.auth.token.email in ['sourthebakeryllc@gmail.com'];
      allow update: if true;  // Allow webhook inventory updates
    }
    
    // Allow order creation for webhooks, admin access for management
    match /orders/{orderId} {
      allow read, update, delete: if request.auth != null &&
        request.auth.token.email in ['sourthebakeryllc@gmail.com'];
      allow create: if true;  // Allow webhook order creation
    }
    
    // Allow read access to settings for everyone, write for admin only
    match /settings/{document=**} {
      allow read: if true;  // This allows customers to read notifications
      allow write: if request.auth != null &&
        request.auth.token.email in ['sourthebakeryllc@gmail.com'];
    }
    
    // Newsletter subscribers - allow anyone to subscribe, admin to manage
    match /newsletter_subscribers/{subscriberId} {
      allow create: if true;  // Anyone can subscribe
      allow read: if true;    // Allow read for duplicate checking
      allow update, delete: if request.auth != null &&
        request.auth.token.email in ['sourthebakeryllc@gmail.com'];
    }
    
    // Newsletter emails - admin only (for sending and viewing history)
    match /newsletter_emails/{emailId} {
      allow read, write: if request.auth != null &&
        request.auth.token.email in ['sourthebakeryllc@gmail.com'];
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}